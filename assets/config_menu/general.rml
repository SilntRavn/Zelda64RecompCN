<template name="config-menu__general">
    <head>
    </head>
    <body>
        <form class="config__form" id="conf-general__form">
            <div class="config__hz-wrapper" id="conf-general__hz-wrapper">
                <!-- Options -->
                <div class="config__wrapper config__wrapper--general-scroll" data-event-mouseout="set_cur_config_index(-1)" id="conf-general__wrapper">
                    <!-- targeting mode -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(0)" id="conf-general__Targeting-Mode">
                        <label class="config-option__title">锁定模式</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(0)"
                                name="targeting_mode"
                                data-checked="targeting_mode"
                                value="Switch"
                                id="tm_switch"
                                style="nav-up: #tab_general; nav-down: #game_speed_1x"
                            />
                            <label class="config-option__tab-label" for="tm_switch">切换</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(0)"
                                name="targeting_mode"
                                data-checked="targeting_mode"
                                value="Hold"
                                id="tm_hold"
                                style="nav-up: #tab_general; nav-down: #game_speed_2x"
                            />
                            <label class="config-option__tab-label" for="tm_hold">按住</label>
                        </div>
                    </div>

                    <!-- game speed -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(12)">
                        <label class="config-option__title">游戏倍速</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(12)"
                                name="game_speed"
                                data-checked="game_speed"
                                value="1x"
                                id="game_speed_1x"
                                style="nav-up: #tm_switch; nav-down: #rumble_strength_input"
                            />
                            <label class="config-option__tab-label" for="game_speed_1x">1x</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(12)"
                                name="game_speed"
                                data-checked="game_speed"
                                value="2x"
                                id="game_speed_2x"
                                style="nav-up: #tm_hold; nav-down: #rumble_strength_input"
                            />
                            <label class="config-option__tab-label" for="game_speed_2x">2x</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(12)"
                                name="game_speed"
                                data-checked="game_speed"
                                value="4x"
                                id="game_speed_4x"
                                style="nav-up: #tm_hold; nav-down: #rumble_strength_input"
                            />
                            <label class="config-option__tab-label" for="game_speed_4x">4x</label>
                        </div>
                    </div>

                    <!-- rumble strength -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(1)">
                        <label class="config-option__title">振动强度</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{rumble_strength}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(1)"
                                id="rumble_strength_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex: 1; margin: 0dp;"
                                data-value="rumble_strength"
                            />
                        </div>
                    </div>

                    <!-- gyro sensitivity -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(2)">
                        <label class="config-option__title">陀螺仪灵敏度</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{gyro_sensitivity}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(2)"
                                id="gyro_sensitivity_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex: 1; margin: 0dp;"
                                data-value="gyro_sensitivity"
                            />
                        </div>
                    </div>

                    <!-- mouse sensitivity -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(3)">
                        <label class="config-option__title">第一人称鼠标灵敏度</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{mouse_sensitivity}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(3)"
                                id="mouse_sensitivity_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex: 1; margin: 0dp;"
                                data-value="mouse_sensitivity"
                            />
                        </div>
                    </div>

                    <!-- third-person mouse X sensitivity -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(4)">
                        <label class="config-option__title">第三人称鼠标 X 轴灵敏度</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{third_person_mouse_sensitivity_x}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(4)"
                                id="third_person_mouse_sensitivity_x_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex: 1; margin: 0dp; nav-down: #third_person_mouse_sensitivity_y_input"
                                data-value="third_person_mouse_sensitivity_x"
                            />
                        </div>
                    </div>

                    <!-- third-person mouse Y sensitivity -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(5)">
                        <label class="config-option__title">第三人称鼠标 Y 轴灵敏度</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{third_person_mouse_sensitivity_y}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(5)"
                                id="third_person_mouse_sensitivity_y_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex: 1; margin: 0dp; nav-up: #third_person_mouse_sensitivity_x_input; nav-down: #joystick_deadzone_input"
                                data-value="third_person_mouse_sensitivity_y"
                            />
                        </div>
                    </div>
                    
                    <!-- joystick deadzone -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(6)">
                        <label class="config-option__title">摇杆死区</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{joystick_deadzone}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(6)"
                                id="joystick_deadzone_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex: 1; margin: 0dp; nav-up: #third_person_mouse_sensitivity_y_input; nav-down: #bg_input_enabled"
                                data-value="joystick_deadzone"
                            />
                        </div>
                    </div>

                    <!-- background input -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(7)" id="conf-general__Background-Input">
                        <label class="config-option__title">后台输入</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(7)"
                                name="background_input_mode"
                                data-checked="background_input_mode"
                                value="On"
                                id="bg_input_enabled"
                                style="nav-up: #joystick_deadzone_input; nav-down: #autosave_enabled"
                            />
                            <label class="config-option__tab-label" for="bg_input_enabled">开启</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(7)"
                                name="background_input_mode"
                                data-checked="background_input_mode"
                                value="Off"
                                id="bg_input_disabled"
                                style="nav-up: #joystick_deadzone_input; nav-down: #autosave_disabled"
                            />
                            <label class="config-option__tab-label" for="bg_input_disabled">关闭</label>
                        </div>
                    </div>

                    <!-- autosave -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(8)">
                        <label class="config-option__title">自动保存</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(8)"
                                name="autosave_mode"
                                data-checked="autosave_mode"
                                value="On"
                                id="autosave_enabled"
                                style="nav-up: #bg_input_enabled; nav-down: #camera_inversion_none"
                            />
                            <label class="config-option__tab-label" for="autosave_enabled">开启</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(8)"
                                name="autosave_mode"
                                data-checked="autosave_mode"
                                value="Off"
                                id="autosave_disabled"
                                style="nav-up: #bg_input_disabled; nav-down: #camera_inversion_x"
                            />
                            <label class="config-option__tab-label" for="autosave_disabled">关闭</label>
                        </div>
                    </div>
                    
                    <!-- camera inversion -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(9)">
                        <label class="config-option__title">瞄准镜头模式</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(9)"
                                name="camera_invert_mode"
                                data-checked="camera_invert_mode"
                                value="InvertNone"
                                id="camera_inversion_none"
                                style="nav-up: #autosave_enabled; nav-down: #analog_cam_enabled"
                            />
                            <label class="config-option__tab-label" for="camera_inversion_none">不反转</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(9)"
                                name="camera_invert_mode"
                                data-checked="camera_invert_mode"
                                value="InvertX"
                                id="camera_inversion_x"
                                style="nav-up: #autosave_disabled; nav-down: #analog_cam_disabled"
                            />
                            <label class="config-option__tab-label" for="camera_inversion_x">反转 X 轴</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(9)"
                                name="camera_invert_mode"
                                data-checked="camera_invert_mode"
                                value="InvertY"
                                id="camera_inversion_y"
                                style="nav-up: #autosave_disabled; nav-down: #analog_cam_disabled"
                            />
                            <label class="config-option__tab-label" for="camera_inversion_y">反转 Y 轴</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(9)"
                                name="camera_invert_mode"
                                data-checked="camera_invert_mode"
                                value="InvertBoth"
                                id="camera_inversion_both"
                                style="nav-up: #autosave_disabled; nav-down: #analog_cam_disabled"
                            />
                            <label class="config-option__tab-label" for="camera_inversion_both">全部反转</label>
                        </div>
                    </div>
                    
                    <!-- analog camera -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(10)">
                        <label class="config-option__title">右摇杆镜头</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(10)"
                                name="analog_cam_mode"
                                data-checked="analog_cam_mode"
                                value="On"
                                id="analog_cam_enabled"
                                style="nav-up: #camera_inversion_none; nav-down: #analog_camera_inversion_none"
                            />
                            <label class="config-option__tab-label" for="analog_cam_enabled">开启</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(10)"
                                name="analog_cam_mode"
                                data-checked="analog_cam_mode"
                                value="Off"
                                id="analog_cam_disabled"
                                style="nav-up: #camera_inversion_x; nav-down: #analog_camera_inversion_x"
                            />
                            <label class="config-option__tab-label" for="analog_cam_disabled">关闭</label>
                        </div>
                    </div>
                    
                    <!-- analog camera inversion -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(11)">
                        <label class="config-option__title">右摇杆镜头方向</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(11)"
                                name="analog_camera_invert_mode"
                                data-checked="analog_camera_invert_mode"
                                value="InvertNone"
                                id="analog_camera_inversion_none"
                                style="nav-up: #analog_cam_enabled;"
                            />
                            <label class="config-option__tab-label" for="analog_camera_inversion_none">不反转</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(11)"
                                name="analog_camera_invert_mode"
                                data-checked="analog_camera_invert_mode"
                                value="InvertX"
                                id="analog_camera_inversion_x"
                                style="nav-up: #analog_cam_disabled;"
                            />
                            <label class="config-option__tab-label" for="analog_camera_inversion_x">反转 X 轴</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(11)"
                                name="analog_camera_invert_mode"
                                data-checked="analog_camera_invert_mode"
                                value="InvertY"
                                id="analog_camera_inversion_y"
                                style="nav-up: #analog_cam_disabled;"
                            />
                            <label class="config-option__tab-label" for="analog_camera_inversion_y">反转 Y 轴</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(11)"
                                name="analog_camera_invert_mode"
                                data-checked="analog_camera_invert_mode"
                                value="InvertBoth"
                                id="analog_camera_inversion_both"
                                style="nav-up: #analog_cam_disabled;"
                            />
                            <label class="config-option__tab-label" for="analog_camera_inversion_both">全部反转</label>
                        </div>
                    </div>

                </div>
                <!-- Descriptions -->
                <div class="config__wrapper">
                    <p data-if="cur_config_index == 0">
                        设置锁定敌人和物体的方式。<br />
                        <b>切换</b>模式下，每次按下锁定键都会开始或停止锁定；<br />
                        <b>按住</b>模式下，按住锁定键时锁定，松开时解除。
                    </p>
                    <p data-if="cur_config_index == 1">
                        调整支持振动的控制器的振动强度。<b>设为零将关闭振动。</b>
                    </p>
                    <p data-if="cur_config_index == 2">
                        调整使用第一人称道具时的陀螺仪瞄准灵敏度。<b>设为零将关闭陀螺仪。</b>
                        <br />
                        <br />
                        <b>提示：要重新校准陀螺仪，请将控制器静置在水平表面 5 秒。</b>
                    </p>
                    <p data-if="cur_config_index == 3">
                        调整第一人称道具瞄准时的鼠标灵敏度。<b>设为零将关闭第一人称鼠标瞄准。</b>
                        <br />
                        <br />
                        <b>鼠标左键、右键和其他按键可在“控制”页的键鼠配置中绑定。</b>
                    </p>
                    <p data-if="cur_config_index == 4">
                        调整第三人称自由镜头的鼠标水平灵敏度。<b>设为零将关闭第三人称镜头的鼠标水平移动。</b>
                    </p>
                    <p data-if="cur_config_index == 5">
                        调整第三人称自由镜头的鼠标垂直灵敏度。<b>设为零将关闭第三人称镜头的鼠标垂直移动。</b>
                    </p>
                    <p data-if="cur_config_index == 6">
                        为摇杆输入设置死区。
                    </p>
                    <p data-if="cur_config_index == 7">
                        允许游戏窗口失去焦点后继续读取控制器输入。<b>此设置不影响键盘输入。</b>
                    </p>
                    <p data-if="cur_config_index == 8">
                        开启自动保存，并防止猫头鹰存档在读取后被删除。
                        <br /><br />
                        自动存档等同于猫头鹰存档，会占用同一存档槽。
                        <br />
                        读取自动存档后，你会出现在时钟镇；若保存时身处迷宫，则会出现在当前迷宫入口。
                        <br /><br />
                        <b>关闭自动保存后，现有自动存档会在读取时被删除。</b>
                    </p>
                    <p data-if="cur_config_index == 9">
                        设置第一人称瞄准的镜头方向。默认值为<b>反转 Y 轴</b>，与原版游戏一致。
                    </p>
                    <p data-if="cur_config_index == 10">
                        启用映射到右摇杆的自由镜头，操作方式类似系列后续作品。
                        <br/>
                        <br/>
                        移动右摇杆后，镜头会进入自由模式，不再自动居于林克身后。<br />
                        随时按下<b>锁定</b>键即可恢复普通镜头。<br />
                        播放过场动画或切换区域后，镜头也会恢复普通模式。
                        <br/>
                        <br/>
                        此选项也会在观察和瞄准时启用右摇杆控制。
                    </p>
                    <p data-if="cur_config_index == 11">
                        设置右摇杆镜头的控制方向。默认值为<b>不反转</b>。
                    </p>
                    <p data-if="cur_config_index == 12">
                        同时加快游戏逻辑、动画、倒计时和声音。<br />
                        可在游戏运行时切换，较高倍速需要更高的处理器性能。
                    </p>
                </div>
            </div>
        </form>
    </body>
</template>
